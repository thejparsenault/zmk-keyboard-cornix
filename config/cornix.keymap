/*
 * Personal keymap converted from cornix.vil.
 * Layer mapping: 0 Base, 1 Navigation, 2 Numpad, 3 Symbols (Vial 5).
 * Unused Vial layers 3, 4, 6, 7, 8, 9 are omitted.
 * Deliberate change: LT4(Delete) becomes plain Delete.
 * USER00/01/02 select BT profiles 0/1/2; USER05 clears the current pairing.
 * Rows are physical left-to-right, including both encoder clicks in row 3.
 */
#include "includes/cornix54.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

// Shipped Cornix positional home-row settings.
#define HM_TAPPING_TERM 250
#define HM_TAPPING_TERM_FAST 200
#define HM_PRIOR_IDLE 70
#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5
#define KEYS_T LH1 LH0 RH0 RH1

// Thumb layer-taps stay tap-preferred, without quick-tap repeat.
&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <250>;
    quick-tap-ms = <0>;
};

/ {
    behaviors {
        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;                // repeat on tap-into-hold
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;
            hold-trigger-on-release;
        };

        hm_shift_r: hm_shift_r {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM_FAST>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;

            // for quick tapping; shift+~

            hold-trigger-on-release;
        };

        vial_scroll: vial_scroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
                &hm_l RALT ESC          &kp Q                 &kp W                 &kp F                 &kp P                 &kp B                 &kp J                 &kp L                 &kp U                 &kp Y                 &kp SEMI              &kp BSPC
                &kp LSHFT             &kp A                 &hm_l LCTRL R           &hm_l LALT S            &hm_l LGUI T            &kp G                 &kp M                 &hm_r RGUI N            &hm_r RALT E            &hm_r RCTRL I           &kp O                 &hm_shift_r RSHFT SQT
                &kp TAB               &kp Z                 &kp X                 &kp C                 &kp D                 &kp V                 &kp C_PLAY_PAUSE      &kp C_MUTE            &kp K                 &kp H                 &kp COMMA             &kp DOT               &kp FSLH              &kp MINUS
                &kp LCTRL             &kp LALT              &kp LGUI              &mo 3                 &kp ENTER             &lt 1 BSPC            &lt 2 SPACE           &kp DEL               &mo 3                 &kp RGUI              &kp RALT              &kp RCTRL
            >;
            sensor-bindings = <&vial_scroll &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        navigation {
            display-name = "Navigation";
            bindings = <
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &kp UP                &none                 &none                 &none
                &kp LSHFT             &none                 &kp LCTRL             &kp LALT              &kp LGUI              &none                 &kp LG(LBKT)          &kp LEFT              &kp DOWN              &kp RIGHT             &kp RG(RBKT)          &none
                &none                 &none                 &none                 &none                 &none                 &none                 &trans                &trans                &none                 &none                 &none                 &none                 &none                 &none
                &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
            >;
            sensor-bindings = <&vial_scroll &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        numpad {
            display-name = "Numpad";
            bindings = <
                &kp KP_N7             &kp KP_N8             &kp KP_N9             &none                 &kp GRAVE             &kp KP_MULTIPLY       &none                 &none                 &none                 &none                 &none                 &none
                &kp KP_N4             &kp KP_N5             &kp KP_N6             &none                 &none                 &kp MINUS             &none                 &kp RGUI              &kp RALT              &kp RCTRL             &none                 &kp RSHFT
                &kp KP_N1             &kp KP_N2             &kp KP_N3             &none                 &kp EQUAL             &kp LS(EQUAL)         &trans                &trans                &none                 &none                 &none                 &none                 &none                 &none
                &kp KP_DOT            &kp KP_N0             &kp KP_ENTER          &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
            >;
            sensor-bindings = <&vial_scroll &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        symbols {
            display-name = "Symbols";
            bindings = <
                &bt BT_CLR            &kp LS(N1)            &kp LS(N2)            &kp LS(N3)            &kp LS(N4)            &kp LS(N5)            &kp LS(N6)            &kp LS(N7)            &kp LS(N8)            &kp LS(N9)            &kp LS(N0)            &none
                &bt BT_SEL 0          &kp LS(COMMA)         &kp LS(LBKT)          &kp LBKT              &kp LS(N9)            &kp LS(MINUS)         &kp KP_EQUAL          &kp LS(N0)            &kp RBKT              &kp LS(RBKT)          &kp LS(DOT)           &none
                &bt BT_SEL 1          &kp LS(BSLH)          &none                 &none                 &none                 &none                 &trans                &trans                &none                 &none                 &none                 &none                 &kp BSLH              &none
                &bt BT_SEL 2          &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none                 &none
            >;
            sensor-bindings = <&vial_scroll &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

    };
};
